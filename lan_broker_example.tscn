[gd_scene load_steps=4 format=3]

[ext_resource type="Script" path="res://lan_broker_example.gd" id="1"]
[ext_resource type="PackedScene" path="res://addons/mqtt/mqtt.tscn" id="2"]
[ext_resource type="PackedScene" path="res://addons/mqtt/lan_broker.tscn" id="3"]

[node name="LANBrokerExample" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1")

[node name="MQTT" parent="." instance=ExtResource("2")]
verbose_level = 1

[node name="LANBroker" parent="." instance=ExtResource("3")]

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 24.0
offset_top = 24.0
offset_right = -24.0
offset_bottom = -24.0
grow_horizontal = 2
grow_vertical = 2

[node name="VBox" type="VBoxContainer" parent="Margin"]
layout_mode = 2

[node name="Title" type="Label" parent="Margin/VBox"]
layout_mode = 2
theme_type_variation = &"HeaderLarge"
text = "MQTT on a LAN"

[node name="Explanation" type="Label" parent="Margin/VBox"]
layout_mode = 2
text = "Looks for an advertised broker. If none appears, the LAN instances elect one to host a small simulated broker."
autowrap_mode = 2

[node name="Status" type="Label" parent="Margin/VBox"]
layout_mode = 2
text = "Starting LAN discovery..."

[node name="SendRow" type="HBoxContainer" parent="Margin/VBox"]
layout_mode = 2

[node name="Message" type="LineEdit" parent="Margin/VBox/SendRow"]
layout_mode = 2
size_flags_horizontal = 3
placeholder_text = "Message to all demo instances"

[node name="Send" type="Button" parent="Margin/VBox/SendRow"]
layout_mode = 2
text = "Publish"

[node name="Log" type="RichTextLabel" parent="Margin/VBox"]
layout_mode = 2
size_flags_vertical = 3
selection_enabled = true

[connection signal="text_submitted" from="Margin/VBox/SendRow/Message" to="." method="_on_message_submitted"]
[connection signal="pressed" from="Margin/VBox/SendRow/Send" to="." method="_on_send_pressed"]
